{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSU Lecture Downloader",
  "version": "0.1.0",
  "identifier": "com.local.ssu-lecture-downloader",
  "build": {
    "beforeDevCommand": "node scripts/dev-or-reuse-vite.mjs",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SSU Lecture Downloader",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "resources": [
      "resources/backend-sidecar"
    ]
  }
}
