{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSU Lecture Downloader",
  "version": "0.2.2",
  "identifier": "com.local.ssu-lecture-downloader",
  "build": {
    "beforeDevCommand": "node scripts/dev-or-reuse-vite.mjs",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SSU Lecture Downloader",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/backend-sidecar"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFNEQ1MkY3RDJFRjVBRDQKUldUVVd1L1M5MUpOcmprK0xwbEY4aXJQa3ZBcnBlRjh1QUVXVWdZTUcvd3g3Nk1hMFJJTVNsbWEK",
      "endpoints": [
        "https://github.com/cafitac/ssu-lecture-downloader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
