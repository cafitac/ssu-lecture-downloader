{
  "name": "ssu-lecture-downloader-ui",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test:contract": "node scripts/contract-test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:backend-sidecar": "cd .. && uv run python scripts/build_backend_sidecar.py",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --config src-tauri/no-updater.conf.json",
    "tauri:build:release": "node scripts/require-signing-key.mjs && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/cli": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3"
  }
}
